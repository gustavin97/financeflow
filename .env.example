# Copie para .env (opcional em desenvolvimento).

# Segredo usado para assinar a sessão (JWT). Em produção, defina um valor longo e aleatório:
#   openssl rand -base64 48
# Se ficar vazio, um segredo aleatório é gerado e guardado em data/.auth-secret.
AUTH_SECRET=

# Banco Postgres do Supabase: Connect -> Session pooler -> URI (troque [YOUR-PASSWORD]).
# Só o servidor usa: nunca exponha no navegador nem suba para o GitHub.
DATABASE_URL=
# Máximo de conexões abertas ao mesmo tempo (padrão 5)
DATABASE_POOL_MAX=

# Defina como "true" quando servir o app via HTTPS (cookie de sessão "Secure").
COOKIE_SECURE=false

# Acesso sem login (entra como o primeiro usuário). Só para desenvolvimento local:
# é ignorado em produção (npm run start).
PUBLIC_ACCESS=false

# Fuso usado para saber quando o mês virou e abrir o mês novo sozinho.
APP_TIMEZONE=America/Sao_Paulo
