# Copie para .env (opcional em desenvolvimento).

# Segredo usado para assinar a sessão (JWT). Em produção, defina um valor longo e aleatório:
#   openssl rand -base64 48
# Se ficar vazio, um segredo aleatório é gerado e guardado em data/.auth-secret.
AUTH_SECRET=

# Caminho do banco SQLite (padrão: ./data/financeflow.db)
DATABASE_PATH=

# Defina como "true" quando servir o app via HTTPS (cookie de sessão "Secure").
COOKIE_SECURE=false

# Acesso temporário sem login. Use false quando o app voltar a exigir autenticação.
PUBLIC_ACCESS=true
